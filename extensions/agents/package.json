    "@theia/workspace": "1.75.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "mocha": "^10.0.0",
    "rimraf": "^5.0.0"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && mocha \"lib/common/*.spec.js\" \"lib/node/*.spec.js\" \"lib/browser/*.spec.js\""
