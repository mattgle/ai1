{
  "name": "ai1-updater",
  "version": "0.1.0",
  "private": true,
  "description": "Checks for updates to AI1 tools and bundled extensions",
  "license": "EPL-2.0",
  "files": [
    "lib",
    "src"
  ],
  "main": "lib/common/updater-protocol.js",
  "dependencies": {
    "@theia/core": "1.75.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "mocha": "^10.0.0",
    "rimraf": "^5.0.0"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && mocha \"lib/**/*.spec.js\""
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/updater-frontend-module",
      "backend": "lib/node/updater-backend-module"
    }
  ]
}
